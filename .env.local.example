NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Cloudinary (server only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Places — public key restricted by HTTP referrer (browser)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Google Places — server-only key for the photo proxy. NEVER prefix NEXT_PUBLIC_
GOOGLE_PLACES_API_KEY=

# Web Push — generate with: node scripts/generate-vapid-keys.mjs
# The PRIVATE key lives only in Supabase Edge Function secrets, never here.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Demo mode (portfolio build only — never set in production)
# NEXT_PUBLIC_DEMO_MODE=1
# NEXT_PUBLIC_DEMO_BACK_URL=https://your-portfolio.example/case-study
